# ---- Local development ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Signs the admin session cookie. MUST be replaced in production.
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Seeded admin account (used by `pnpm db:seed`)
ADMIN_EMAIL="owner@alrahmanenterprises.in"
ADMIN_PASSWORD="set-a-strong-password"

# Image storage: "local" (writes to ./public/uploads) or "supabase"
STORAGE_DRIVER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="product-images"

NEXT_PUBLIC_SITE_URL="https://your-domain.com"
